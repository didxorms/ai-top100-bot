BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# echo: OpenAI를 호출하지 않는 연결 테스트 / openai: 실제 LLM 답변
LLM_MODE=echo
# auto: 최신 정보가 필요할 때 OpenAI 웹 검색 사용 (검색 추가 요금) / off: 검색 끄기
WEB_SEARCH_MODE=auto
KAKAO_TEXT_PATH=d.content
# off: 기존 대화 봇 / mock: 가상 행사 조회·신청 실습 (실제 예약·결제 없음)
ACTION_MODE=off
# 로컬에서는 .local, 외부 서버에서는 영구 볼륨을 붙인 /data를 사용합니다.
DATA_DIR=.local
